{
  "dut": "uart",
  "dut_top": "UART",
  "golden_rtl": "dut/uart/rtl",
  "top": "uart_sc_tb",
  "bugs": [
    {"id": "B01_baud_period_short", "dut": "uart", "type": "corner", "file": "Baud_Rate_Generator.v",
     "find": "else if(count == BAUD_CNT) begin", "replace": "else if(count == BAUD_CNT - 1) begin", "expect_count": 1,
     "description": "baud tick 주기가 433 ck로 짧아져 TX 비트 폭과 시작 시점이 어긋난다", "equivalent": false},
    {"id": "B02_baud_wrap_one", "dut": "uart", "type": "corner", "file": "Baud_Rate_Generator.v",
     "find": "count <= 0;", "replace": "count <= 1;", "occurrence": 2, "expect_count": 2,
     "description": "카운터가 0이 아니라 1로 돌아가 첫 주기 이후 tick 주기가 433 ck가 된다", "equivalent": false},
    {"id": "B03_baud_reset_count", "dut": "uart", "type": "reset", "file": "Baud_Rate_Generator.v",
     "find": "count <= 0;", "replace": "count <= 100;", "occurrence": 1, "expect_count": 2,
     "description": "리셋 시 카운터 시작값이 100이라 tick 위상이 리셋 기준에서 어긋난다", "equivalent": false},
    {"id": "B04_baud_tick_stuck", "dut": "uart", "type": "flag", "file": "Baud_Rate_Generator.v",
     "find": "baud_tick <= 0;", "replace": "baud_tick <= baud_tick;", "occurrence": 2, "expect_count": 2,
     "description": "baud_tick이 한 번 1이 되면 내려가지 않아 TX가 매 ck마다 진행한다", "equivalent": false},
    {"id": "B05_tx_msb_first", "dut": "uart", "type": "pointer", "file": "UART_TX.v",
     "find": "tx   <= data_tmp[bit_idx];", "replace": "tx   <= data_tmp[7 - bit_idx];", "expect_count": 1,
     "description": "TX가 MSB부터 보낸다 (명세는 LSB first)", "equivalent": false},
    {"id": "B06_tx_7bits", "dut": "uart", "type": "pointer", "file": "UART_TX.v",
     "find": "if (bit_idx == 7) begin", "replace": "if (bit_idx == 6) begin", "expect_count": 1,
     "description": "TX 데이터 비트가 7개뿐이다", "equivalent": false},
    {"id": "B07_tx_bitidx_no_clear", "dut": "uart", "type": "pointer", "file": "UART_TX.v",
     "find": "bit_idx  <= 0;", "replace": "bit_idx  <= bit_idx;", "expect_count": 1,
     "description": "수락 시 bit_idx를 0으로 되돌리지 않아 두 번째 프레임부터 데이터 비트가 1개뿐이다", "equivalent": false},
    {"id": "B08_tx_start_bit_high", "dut": "uart", "type": "corner", "file": "UART_TX.v",
     "find": "tx    <= 0;", "replace": "tx    <= 1;", "expect_count": 1,
     "description": "start 비트가 1이라 프레임 시작이 보이지 않는다", "equivalent": false},
    {"id": "B09_tx_stop_bit_low", "dut": "uart", "type": "corner", "file": "UART_TX.v",
     "find": "tx    <= 1;", "replace": "tx    <= 0;", "occurrence": 2, "expect_count": 2,
     "description": "stop 비트가 0이다", "equivalent": false},
    {"id": "B10_tx_reset_low", "dut": "uart", "type": "reset", "file": "UART_TX.v",
     "find": "tx    <= 1;", "replace": "tx    <= 0;", "occurrence": 1, "expect_count": 2,
     "description": "리셋 시 tx가 0이다 (유휴 레벨은 1)", "equivalent": false},
    {"id": "B11_tx_busy_reset_high", "dut": "uart", "type": "reset", "file": "UART_TX.v",
     "find": "busy  <= 0;", "replace": "busy  <= 1;", "expect_count": 1,
     "description": "리셋 시 tx_busy가 1이다", "equivalent": false},
    {"id": "B12_tx_busy_late", "dut": "uart", "type": "flag", "file": "UART_TX.v",
     "find": "busy  <= 1;", "replace": "busy  <= 0;", "occurrence": 1, "expect_count": 2,
     "description": "START에서 busy를 올리지 않아 tx_busy가 1비트 늦게 오른다", "equivalent": false},
    {"id": "B13_tx_busy_early_fall", "dut": "uart", "type": "flag", "file": "UART_TX.v",
     "find": "busy  <= 1;", "replace": "busy  <= 0;", "occurrence": 2, "expect_count": 2,
     "description": "STOP에서 busy를 내려 tx_busy가 stop 비트 시작에서 떨어진다", "equivalent": false},
    {"id": "B14_tx_no_latch", "dut": "uart", "type": "guard", "file": "UART_TX.v",
     "find": "tx   <= data_tmp[bit_idx];", "replace": "tx   <= tx_data[bit_idx];", "expect_count": 1,
     "description": "래치한 값이 아니라 현재 tx_data를 보내 전송 중 입력 변화가 프레임에 섞인다", "equivalent": false},
    {"id": "B15_tx_ignore_tick", "dut": "uart", "type": "corner", "file": "UART_TX.v",
     "find": "else if (baud_tick) begin", "replace": "else begin", "expect_count": 1,
     "description": "TX가 baud_tick을 무시하고 매 ck마다 진행한다", "equivalent": false},
    {"id": "B16_tx_auto_restart", "dut": "uart", "type": "guard", "file": "UART_TX.v",
     "find": "state <= IDLE;", "replace": "state <= START;", "occurrence": 2, "expect_count": 2,
     "description": "STOP 뒤 IDLE로 가지 않고 바로 START로 가서 tx_start 없이 프레임이 반복된다", "equivalent": false},
    {"id": "B17_tx_skip_stop", "dut": "uart", "type": "corner", "file": "UART_TX.v",
     "find": "state <= STOP;", "replace": "state <= IDLE;", "expect_count": 1,
     "description": "STOP 상태를 건너뛰어 tx_busy가 stop 비트 구간에서 이미 0이다", "equivalent": false},
    {"id": "B18_rx_sample_edge", "dut": "uart", "type": "corner", "file": "UART_RX.v",
     "find": "if (baud_count == BAUD_CNT/2) begin", "replace": "if (baud_count == 0) begin", "expect_count": 1,
     "description": "start 비트에서 반 비트를 기다리지 않아 비트 중앙이 아니라 경계 근처에서 샘플한다", "equivalent": false},
    {"id": "B19_rx_msb_first", "dut": "uart", "type": "pointer", "file": "UART_RX.v",
     "find": "data_tmp[bit_idx] <= rx;", "replace": "data_tmp[7 - bit_idx] <= rx;", "expect_count": 1,
     "description": "RX가 첫 비트를 MSB 자리에 넣는다 (명세는 LSB first)", "equivalent": false},
    {"id": "B20_rx_7bits", "dut": "uart", "type": "pointer", "file": "UART_RX.v",
     "find": "if (bit_idx == 7)", "replace": "if (bit_idx == 6)", "expect_count": 1,
     "description": "RX가 7비트만 받고 STOP으로 가서 8번째 데이터 비트를 stop 비트로 샘플한다", "equivalent": false},
    {"id": "B21_rx_bitidx_no_clear", "dut": "uart", "type": "pointer", "file": "UART_RX.v",
     "find": "bit_idx <= 0;", "replace": "bit_idx <= bit_idx;", "occurrence": 2, "expect_count": 2,
     "description": "START에서 bit_idx를 0으로 되돌리지 않아 두 번째 프레임부터 비트 위치가 틀린다", "equivalent": false},
    {"id": "B22_rx_no_stop_check", "dut": "uart", "type": "guard", "file": "UART_RX.v",
     "find": "if (rx == 1) begin", "replace": "if (1) begin", "expect_count": 1,
     "description": "stop 비트를 확인하지 않아 stop=0인 프레임도 data_valid를 낸다", "equivalent": false},
    {"id": "B23_rx_start_on_high", "dut": "uart", "type": "guard", "file": "UART_RX.v",
     "find": "if(rx == 0) begin", "replace": "if(rx == 1) begin", "expect_count": 1,
     "description": "유휴(1)에서 start로 오인해 프레임이 없는데도 수신을 시작한다", "equivalent": false},
    {"id": "B24_rx_valid_stuck", "dut": "uart", "type": "flag", "file": "UART_RX.v",
     "find": "data_valid <= 0;", "replace": "data_valid <= data_valid;", "occurrence": 2, "expect_count": 2,
     "description": "IDLE에서 data_valid를 내리지 않아 1주기 펄스가 아니라 계속 1이다", "equivalent": false},
    {"id": "B25_rx_valid_reset_high", "dut": "uart", "type": "reset", "file": "UART_RX.v",
     "find": "data_valid <= 0;", "replace": "data_valid <= 1;", "occurrence": 1, "expect_count": 2,
     "description": "리셋 시 data_valid가 1이다", "equivalent": false},
    {"id": "B26_rx_data_reset_ff", "dut": "uart", "type": "reset", "file": "UART_RX.v",
     "find": "rx_data <= 0;", "replace": "rx_data <= 8'hFF;", "expect_count": 1,
     "description": "리셋 시 rx_data가 FF다", "equivalent": false},
    {"id": "B27_rx_count_no_clear", "dut": "uart", "type": "corner", "file": "UART_RX.v",
     "find": "baud_count <= 0;", "replace": "baud_count <= baud_count;", "occurrence": 3, "expect_count": 5,
     "description": "START에서 DATA로 갈 때 baud_count를 0으로 되돌리지 않아 첫 데이터 비트를 일찍(비트 경계 근처에서) 샘플한다", "equivalent": false},
    {"id": "B28_rx_stop_half", "dut": "uart", "type": "corner", "file": "UART_RX.v",
     "find": "if (baud_count == BAUD_CNT) begin", "replace": "if (baud_count == BAUD_CNT/2) begin", "occurrence": 2, "expect_count": 2,
     "description": "stop 비트를 반 비트만 기다려 data_valid가 9.0비트 시점(비트 경계)에 나온다", "equivalent": false},
    {"id": "B29_rx_data_period_short", "dut": "uart", "type": "corner", "file": "UART_RX.v",
     "find": "if (baud_count == BAUD_CNT) begin", "replace": "if (baud_count == BAUD_CNT - 1) begin", "occurrence": 1, "expect_count": 2,
     "description": "데이터 비트 간격이 433 ck라 샘플 시점이 비트마다 1 ck씩 당겨진다", "equivalent": false},
    {"id": "B30_top_tick_tied", "dut": "uart", "type": "guard", "file": "UART.v",
     "find": ".baud_tick(baud_tick),", "replace": ".baud_tick(1'b1),", "expect_count": 1,
     "description": "TX의 baud_tick 입력이 1로 묶여 TX가 매 ck마다 진행한다", "equivalent": false},
    {"id": "E01_rx_counter_wider", "dut": "uart", "type": "corner", "file": "UART_RX.v",
     "find": "reg [8:0] baud_count;", "replace": "reg [9:0] baud_count;", "expect_count": 1,
     "description": "baud_count 폭만 넓힘. 값이 433을 넘지 않으므로 동작이 같다", "equivalent": true},
    {"id": "E02_tx_idle_redundant", "dut": "uart", "type": "flag", "file": "UART_TX.v",
     "find": "tx   <= 1;", "replace": "tx   <= tx;", "expect_count": 1,
     "description": "IDLE의 tx <= 1 제거. IDLE에 들어올 때 tx는 이미 1(리셋 또는 STOP)이므로 동작이 같다", "equivalent": true}
  ]
}
