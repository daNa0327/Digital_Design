{
  "dut": "i2c",
  "dut_top": "i2c_system",
  "golden_rtl": "dut/i2c/rtl",
  "top": "i2c_sc_tb",
  "bugs": [
    {"id": "B01_div_period_short", "dut": "i2c", "type": "corner", "file": "clock_divider.v",
     "find": "else if (count == DIV) begin", "replace": "else if (count == DIV - 1) begin", "expect_count": 1,
     "description": "tick 주기가 124 ck로 짧아져 SCL high/low 구간이 250 ck가 아니다", "equivalent": false},
    {"id": "B02_div_count_step2", "dut": "i2c", "type": "corner", "file": "clock_divider.v",
     "find": "count <= count + 1;", "replace": "count <= count + 2;", "expect_count": 1,
     "description": "분주 카운터가 2씩 증가해 SCL 주기가 바뀐다", "equivalent": false},
    {"id": "B03_div_tick_stuck", "dut": "i2c", "type": "flag", "file": "clock_divider.v",
     "find": "tick  <= 0;", "replace": "tick  <= tick;", "occurrence": 2, "expect_count": 2,
     "description": "tick이 한 번 1이 되면 내려가지 않아 FSM이 매 ck마다 진행한다", "equivalent": false},
    {"id": "B04_fsm_no_start_cond", "dut": "i2c", "type": "corner", "file": "Master_FSM.v",
     "find": "if (phase == 2'd0) sda_low <= 1'b1;", "replace": "if (phase == 2'd0) sda_low <= 1'b0;", "expect_count": 1,
     "description": "START에서 SCL high 동안 SDA를 내리지 않아 START 조건이 없다", "equivalent": false},
    {"id": "B05_fsm_tx_inverted", "dut": "i2c", "type": "flag", "file": "Master_FSM.v",
     "find": "2'd0: sda_low <= ~tx_bit;", "replace": "2'd0: sda_low <= tx_bit;", "expect_count": 1,
     "description": "Master가 보내는 비트를 반전해서 SDA에 싣는다", "equivalent": false},
    {"id": "B06_fsm_7bits_tx", "dut": "i2c", "type": "pointer", "file": "Master_FSM.v",
     "find": "if (bit_cnt == 3'd7)", "replace": "if (bit_cnt == 3'd6)", "occurrence": 1, "expect_count": 2,
     "description": "주소/쓰기 데이터 단계가 7비트에서 끝난다", "equivalent": false},
    {"id": "B07_fsm_7bits_rx", "dut": "i2c", "type": "pointer", "file": "Master_FSM.v",
     "find": "if (bit_cnt == 3'd7)", "replace": "if (bit_cnt == 3'd6)", "occurrence": 2, "expect_count": 2,
     "description": "읽기 데이터 단계가 7비트에서 끝난다", "equivalent": false},
    {"id": "B08_fsm_ignore_nack", "dut": "i2c", "type": "guard", "file": "Master_FSM.v",
     "find": "2'd2: if (sda_in) ack_error <= 1'b1;", "replace": "2'd2: if (1'b0) ack_error <= 1'b1;", "expect_count": 1,
     "description": "ACK 자리의 SDA를 보지 않아 NACK을 받아도 ack_error가 0이고 데이터 단계로 간다", "equivalent": false},
    {"id": "B09_fsm_ack_error_sticky", "dut": "i2c", "type": "flag", "file": "Master_FSM.v",
     "find": "ack_error <= 1'b0;", "replace": "ack_error <= ack_error;", "occurrence": 2, "expect_count": 2,
     "description": "새 트랜잭션에서 ack_error를 지우지 않아 한 번 NACK 뒤 계속 1이다", "equivalent": false},
    {"id": "B10_fsm_nack_continue", "dut": "i2c", "type": "guard", "file": "Master_FSM.v",
     "find": "if (state == ACK_W || ack_error)", "replace": "if (state == ACK_W)", "expect_count": 1,
     "description": "주소 NACK 뒤에도 STOP하지 않고 데이터 단계를 진행한다", "equivalent": false},
    {"id": "B11_fsm_rw_swapped", "dut": "i2c", "type": "guard", "file": "Master_FSM.v",
     "find": "else if (rw_q)", "replace": "else if (!rw_q)", "expect_count": 1,
     "description": "주소 ACK 뒤 읽기와 쓰기 분기가 뒤바뀐다", "equivalent": false},
    {"id": "B12_fsm_no_stop_cond", "dut": "i2c", "type": "corner", "file": "Master_FSM.v",
     "find": "2'd2: sda_low <= 1'b0;", "replace": "2'd2: sda_low <= 1'b1;", "expect_count": 1,
     "description": "STOP에서 SDA를 올리지 않아 STOP 조건이 없고 SDA가 0으로 남는다", "equivalent": false},
    {"id": "B13_fsm_done_short", "dut": "i2c", "type": "flag", "file": "Master_FSM.v",
     "find": "if (phase == 2'd3) begin", "replace": "if (phase == 2'd0) begin", "expect_count": 1,
     "description": "done이 4 tick이 아니라 1 tick만 유지된다", "equivalent": false},
    {"id": "B14_fsm_nack_no_clock", "dut": "i2c", "type": "corner", "file": "Master_FSM.v",
     "find": "2'd1: SCL <= 1'b1;", "replace": "2'd1: SCL <= 1'b0;", "occurrence": 4, "expect_count": 5,
     "description": "읽기 끝의 NACK 비트에서 SCL을 올리지 않아 클록이 하나 빠진다", "equivalent": false},
    {"id": "B15_fsm_start_scl_early", "dut": "i2c", "type": "corner", "file": "Master_FSM.v",
     "find": "if (phase == 2'd2) SCL <= 1'b0;", "replace": "if (phase == 2'd1) SCL <= 1'b0;", "expect_count": 1,
     "description": "START 뒤 SCL이 1 tick 일찍 내려가 START 유지 시간이 125 ck다", "equivalent": false},
    {"id": "B16_fsm_reset_scl_low", "dut": "i2c", "type": "reset", "file": "Master_FSM.v",
     "find": "SCL       <= 1'b1;", "replace": "SCL       <= 1'b0;", "expect_count": 1,
     "description": "리셋 시 SCL이 0이다 (유휴 레벨은 1)", "equivalent": false},
    {"id": "B17_fsm_no_load_data", "dut": "i2c", "type": "guard", "file": "Master_FSM.v",
     "find": "load_data <= 1'b1;", "replace": "load_data <= 1'b0;", "expect_count": 1,
     "description": "쓰기 데이터를 적재하지 않아 주소를 민 나머지(0)가 데이터로 나간다", "equivalent": false},
    {"id": "B18_mtx_lsb_first", "dut": "i2c", "type": "pointer", "file": "Master_TX.v",
     "find": "assign tx_bit = tx_reg[7];", "replace": "assign tx_bit = tx_reg[0];", "expect_count": 1,
     "description": "Master가 MSB가 아니라 최하위 비트를 내보낸다", "equivalent": false},
    {"id": "B19_mtx_addr_order", "dut": "i2c", "type": "pointer", "file": "Master_TX.v",
     "find": "tx_reg <= {addr, rw};", "replace": "tx_reg <= {rw, addr};", "expect_count": 1,
     "description": "주소 바이트에서 R/W 비트를 맨 앞에 둔다 (명세는 주소 7비트 뒤 R/W)", "equivalent": false},
    {"id": "B20_mrx_shift_right", "dut": "i2c", "type": "pointer", "file": "Master_RX.v",
     "find": "rx_data <= {rx_data[6:0], sda_in};", "replace": "rx_data <= {sda_in, rx_data[7:1]};", "expect_count": 1,
     "description": "Master RX가 오른쪽으로 시프트해 받은 바이트의 비트 순서가 뒤집힌다", "equivalent": false},
    {"id": "B21_mrx_reset_ff", "dut": "i2c", "type": "reset", "file": "Master_RX.v",
     "find": "rx_data <= 8'b0;", "replace": "rx_data <= 8'hFF;", "expect_count": 1,
     "description": "리셋 시 master_rx_data가 FF다", "equivalent": false},
    {"id": "B22_slv_addr_bits", "dut": "i2c", "type": "pointer", "file": "Slave_FSM.v",
     "find": "if (rx_shreg[7:1] == SLAVE_ADDR) begin", "replace": "if (rx_shreg[6:0] == SLAVE_ADDR) begin", "expect_count": 1,
     "description": "Slave가 주소 비교에 R/W 비트를 포함한 아래 7비트를 쓴다", "equivalent": false},
    {"id": "B23_slv_no_addr_ack", "dut": "i2c", "type": "flag", "file": "Slave_FSM.v",
     "find": "sda_low <= 1'b1;", "replace": "sda_low <= 1'b0;", "expect_count": 1,
     "description": "주소가 맞아도 Slave가 ACK하지 않는다", "equivalent": false},
    {"id": "B24_slv_no_write_ack", "dut": "i2c", "type": "flag", "file": "Slave_FSM.v",
     "find": "sda_low  <= 1'b1;", "replace": "sda_low  <= 1'b0;", "expect_count": 1,
     "description": "쓰기 데이터를 받은 뒤 Slave가 ACK하지 않는다", "equivalent": false},
    {"id": "B25_slv_read_msb_lost", "dut": "i2c", "type": "corner", "file": "Slave_FSM.v",
     "find": "sda_low <= ~tx_bit;", "replace": "sda_low <= 1'b0;", "occurrence": 1, "expect_count": 2,
     "description": "읽기 첫 비트(MSB)를 구동하지 않아 항상 1로 읽힌다", "equivalent": false},
    {"id": "B26_slv_shift_on_fall", "dut": "i2c", "type": "pointer", "file": "Slave_FSM.v",
     "find": "if (scl_rise) begin                      // Master", "replace": "if (scl_fall) begin                      // Master", "expect_count": 1,
     "description": "읽기에서 Slave TX를 SCL 하강에 시프트해 다음 비트를 늦게 내보낸다 (비트 중복)", "equivalent": false},
    {"id": "B27_slv_no_rx_latch", "dut": "i2c", "type": "flag", "file": "Slave_FSM.v",
     "find": "rx_latch <= 1'b1;", "replace": "rx_latch <= 1'b0;", "expect_count": 1,
     "description": "쓰기 데이터를 받아도 slave_rx_data를 갱신하지 않는다", "equivalent": false},
    {"id": "B28_stx_shift_right", "dut": "i2c", "type": "pointer", "file": "Slave_TX.v",
     "find": "tx_reg <= {tx_reg[6:0], 1'b0};", "replace": "tx_reg <= {1'b0, tx_reg[7:1]};", "expect_count": 1,
     "description": "Slave TX가 오른쪽으로 시프트해 두 번째 비트부터 틀린다", "equivalent": false},
    {"id": "B29_srx_reset_ff", "dut": "i2c", "type": "reset", "file": "Slave_RX.v",
     "find": "rx_data  <= 8'b0;", "replace": "rx_data  <= 8'hFF;", "expect_count": 1,
     "description": "리셋 시 slave_rx_data가 FF다", "equivalent": false},
    {"id": "B30_top_sda_master_only", "dut": "i2c", "type": "guard", "file": "i2c_system.v",
     "find": "assign SDA = ~(m_sda_low | s_sda_low);", "replace": "assign SDA = ~m_sda_low;", "expect_count": 1,
     "description": "SDA가 Master만 반영해 Slave의 ACK와 읽기 데이터가 버스에 나타나지 않는다", "equivalent": false},
    {"id": "E01_mtx_reset_ff", "dut": "i2c", "type": "reset", "file": "Master_TX.v",
     "find": "tx_reg <= 8'b0;", "replace": "tx_reg <= 8'hFF;", "expect_count": 1,
     "description": "Master TX 레지스터 리셋 값만 바꿈. 첫 사용 전에 항상 주소로 적재되므로 동작이 같다", "equivalent": true},
    {"id": "E02_slv_start_no_sclq", "dut": "i2c", "type": "guard", "file": "Slave_FSM.v",
     "find": "wire start_det = SCL & scl_q & sda_q & ~sda_in;", "replace": "wire start_det = SCL & sda_q & ~sda_in;", "expect_count": 1,
     "description": "START 검출에서 이전 SCL 조건 제거. SCL 상승과 SDA 하강이 같은 ck에 일어나는 경우가 없으므로 동작이 같다", "equivalent": true}
  ]
}
