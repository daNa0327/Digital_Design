      "type": "corner",
      "file": "clock_divider.v",
      "find": "count <= count + 1;",
      "replace": "count <= count + 2;",
      "expect_count": 1,
      "description": "분주 카운터가 2씩 증가해 spi_clk 주기가 바뀐다",
      "equivalent": false
    },
    {
      "id": "B03_div_never_toggle",
