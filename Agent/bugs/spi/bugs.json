    {
      "id": "B01_div_period_off",
      "dut": "spi",
      "type": "corner",
      "file": "clock_divider.v",
      "find": "else if (count == DIV) begin",
      "replace": "else if (count == DIV - 1) begin",
      "expect_count": 1,
      "description": "분주 비교값이 하나 작아 spi_clk 주기가 1000ns보다 짧아진다",
      "equivalent": false
    },
    {
      "id": "B02_div_count_step2",
